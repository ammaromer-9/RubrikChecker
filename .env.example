# --- Database ---
DATABASE_URL=postgresql+asyncpg://rubriccheck:rubriccheck@localhost:5432/rubriccheck
TEST_DATABASE_URL=postgresql+asyncpg://rubriccheck:rubriccheck@localhost:5432/rubriccheck_test

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=replace-me-with-a-model-id

# --- Limits ---
MAX_DRAFT_CHARS=50000
MAX_ASSIGNMENT_TEXT_CHARS=20000
MAX_UPLOAD_BYTES=5242880

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Grading ---
GRADING_RUNS=3
GRADING_TEMPERATURE=0.7
GRADING_CONCURRENCY=5
FEEDBACK_MAX_QUOTED_WORDS=25
