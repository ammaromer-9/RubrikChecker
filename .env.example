# --- Database ---
DATABASE_URL=postgresql+asyncpg://rubriccheck:rubriccheck@localhost:5432/rubriccheck
TEST_DATABASE_URL=postgresql+asyncpg://rubriccheck:rubriccheck@localhost:5432/rubriccheck_test

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=claude-sonnet-5-5
# Thinking depth: low | medium | high | xhigh | max (empty = model default)
ANTHROPIC_EFFORT=medium

# --- Limits ---
MAX_DRAFT_CHARS=50000
MAX_ASSIGNMENT_TEXT_CHARS=20000
MAX_UPLOAD_BYTES=5242880

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Grading ---
GRADING_RUNS=3
GRADING_CONCURRENCY=5
FEEDBACK_MAX_QUOTED_WORDS=25

# --- Server ---
LOG_LEVEL=INFO
GRADING_STALE_MINUTES=30
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# --- Accounts and limits ---
SESSION_DAYS=30
# Set to true when the site is served over HTTPS (required for any real deployment)
COOKIE_SECURE=false
# Set to false to close sign-ups
ALLOW_REGISTRATION=true
MAX_PROJECTS_PER_USER=50
MAX_GRADINGS_PER_DAY=30
